+\begin{lemma}[Linear and sublinear variance from the integrated bound]
+\label{lem:integrated-consequences}
+Let $P$ be a stationary simple point process of intensity one with
+$\mathcal V(P)<\infty$. Then every bounded interval has a finite second
+count moment, and
+\begin{align}
+v_P(t)&\le C_Pt\quad(t>0),\qquad
+ C_P:=36\mathcal V(P)+2,\label{eq:linear}\\
+\lim_{t\to\infty}\frac{v_P(t)}t&=0.\label{eq:hyper}
+\end{align}
+More precisely, for every $t>0$,
+\begin{equation}\label{eq:variance-tail-control}
+\frac{v_P(t)}t
+\le18\int_t^{3t}\frac{v_P(u)}{u^2}\dd u.
+\end{equation}
+\end{lemma}
+\end{samepage}
+
+\begin{proof}
+For each $L>0$, finiteness of $\mathcal V(P)$ gives some
+$T>\max\{1,L\}$ with $v_P(T)<\infty$. Since
+$N_{(0,L]}\le N_{(0,T]}$, the count in $(0,L]$ has a finite second
+moment. Stationarity gives the same conclusion for every bounded
+interval.
+
+Put $D_t=N_{(0,t]}-t$. For $s,t>0$,
+\[
+D_t=D_{t+s}-\bigl(N_{(t,t+s]}-s\bigr).
+\]
+By stationarity and $(a-b)^2\le2a^2+2b^2$,
+\[
+v_P(t)\le2v_P(t+s)+2v_P(s).
+\]
+Integrate over $s\in[t,2t]$ to obtain
+\[
+tv_P(t)\le2\int_t^{3t}v_P(u)\dd u
+\le18t^2\int_t^{3t}\frac{v_P(u)}{u^2}\dd u,
+\]
+which proves \eqref{eq:variance-tail-control}. Its right-hand side
+tends to zero as $t\to\infty$, proving \eqref{eq:hyper}; for $t\ge1$
+it also gives $v_P(t)\le18\mathcal V(P)t$.
+
+If $0<t<1$, let $m=\lfloor1/t\rfloor$. Disjointness of the intervals
+and stationarity imply
+\[
+m\E_PN_{(0,t]}^2
+ =\E_P\sum_{j=0}^{m-1}N_{(jt,(j+1)t]}^2
+ \le\E_PN_{(0,1]}^2=v_P(1)+1.
+\]
+Since $m\ge1/(2t)$ and $v_P(1)\le18\mathcal V(P)$,
+\[
+v_P(t)\le\E_PN_{(0,t]}^2
+\le2t\bigl(v_P(1)+1\bigr)
+\le\bigl(36\mathcal V(P)+2\bigr)t.
+\]
+This proves \eqref{eq:linear} at all scales.
+\end{proof}
